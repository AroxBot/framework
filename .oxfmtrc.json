{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"ignorePatterns": ["dist", "node_modules", "build", "CHANGELOG.md"],
	"tabWidth": 2,
	"useTabs": true,
	"printWidth": 80,
	"semi": true,
	"singleQuote": false,
	"trailingComma": "es5",
	"bracketSpacing": true,
	"arrowParens": "always",

	"jsxSingleQuote": false,
	"quoteProps": "as-needed",
	"embeddedLanguageFormatting": "auto"
}
